<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Monochrome, light. Same keys as Palette.Dark.xaml. -->
    <SolidColorBrush x:Key="Ebb.Bg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ebb.Surface" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Ebb.SurfaceHover" Color="#F2F2F2" />
    <SolidColorBrush x:Key="Ebb.Border" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Ebb.BorderStrong" Color="#C7C7C7" />
    <SolidColorBrush x:Key="Ebb.Text" Color="#0A0A0A" />
    <SolidColorBrush x:Key="Ebb.TextMuted" Color="#525252" />
    <SolidColorBrush x:Key="Ebb.TextFaint" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Ebb.Inverse" Color="#0A0A0A" />
    <SolidColorBrush x:Key="Ebb.InverseHover" Color="#333333" />
    <SolidColorBrush x:Key="Ebb.InverseText" Color="#FFFFFF" />

    <DrawingBrush x:Key="Ebb.Hatch" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,6 L6,0 M-1,1 L1,-1 M5,7 L7,5">
                <GeometryDrawing.Pen>
                    <Pen Brush="#0A0A0A" Thickness="1.2" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
