<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Square corners everywhere, Geist for text, Geist Mono for numbers, paths and labels. -->
    <FontFamily x:Key="Ebb.Sans">pack://application:,,,/Ebb;component/Fonts/#Geist</FontFamily>
    <FontFamily x:Key="Ebb.Mono">pack://application:,,,/Ebb;component/Fonts/#Geist Mono</FontFamily>

    <!--  Text  -->
    <Style x:Key="Ebb.Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ebb.Mono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Ebb.TextFaint}" />
    </Style>
    <Style x:Key="Ebb.H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ebb.Text}" />
    </Style>
    <Style x:Key="Ebb.H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ebb.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Ebb.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Ebb.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Ebb.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="{DynamicResource Ebb.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Ebb.Meta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ebb.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ebb.TextFaint}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Ebb.Number" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ebb.Mono}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource Ebb.Text}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!--  Focus: a thin dashed outline  -->
    <Style x:Key="Ebb.Focus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" SnapsToDevicePixels="True" Stroke="{DynamicResource Ebb.Text}" StrokeDashArray="2 2" StrokeThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Buttons  -->
    <Style x:Key="Ebb.ButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Ebb.Sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ebb.Focus}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ebb.Primary" BasedOn="{StaticResource Ebb.ButtonBase}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Ebb.Inverse}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ebb.Inverse}" />
        <Setter Property="Foreground" Value="{DynamicResource Ebb.InverseText}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ebb.InverseHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Ebb.InverseHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Ebb.Ghost" BasedOn="{StaticResource Ebb.ButtonBase}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ebb.BorderStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource Ebb.Text}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ebb.SurfaceHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Ebb.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Ebb.Link" BasedOn="{StaticResource Ebb.ButtonBase}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource Ebb.Mono}" />
        <Setter Property="Foreground" Value="{DynamicResource Ebb.Text}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Ebb.TextMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  A plain text box. Tag is the placeholder.  -->
    <Style x:Key="Ebb.Input" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Ebb.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ebb.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Ebb.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Ebb.TextMuted}" />
        <Setter Property="Background" Value="{DynamicResource Ebb.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ebb.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <!--  The TextBox puts its Padding on the content host itself; the placeholder lines up with it  -->
                        <Grid>
                            <TextBlock
                                x:Name="Placeholder"
                                Margin="12,0,10,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Ebb.TextFaint}"
                                IsHitTestVisible="False"
                                Text="{TemplateBinding Tag}"
                                Visibility="Collapsed" />
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Focusable="False"
                                Style="{x:Null}"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Ebb.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Ebb.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  A full-width clickable row with a bottom rule.  -->
    <Style x:Key="Ebb.Row" BasedOn="{StaticResource Ebb.ButtonBase}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ebb.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Ebb.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ebb.Surface}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Check box: a square that fills in  -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Ebb.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ebb.Focus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="Box"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Top"
                            Margin="0,1,0,0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Ebb.BorderStrong}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Path
                                    x:Name="Mark"
                                    Data="M 2.5,7 L 5.5,10 L 11.5,3.5"
                                    Stroke="{DynamicResource Ebb.InverseText}"
                                    StrokeThickness="1.6"
                                    Visibility="Collapsed" />
                                <!--  Some ticked: a dash in the box  -->
                                <Rectangle
                                    x:Name="Partial"
                                    Width="8"
                                    Height="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource Ebb.Text}"
                                    SnapsToDevicePixels="True"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ebb.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Ebb.Inverse}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ebb.Inverse}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Partial" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.25" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Lists without any chrome  -->
    <Style x:Key="Ebb.PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Left navigation item: a bar on the left when selected  -->
    <Style x:Key="Ebb.NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Ebb.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ebb.Focus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Root" Background="Transparent">
                        <Rectangle x:Name="Bar" Width="2" HorizontalAlignment="Left" Fill="{DynamicResource Ebb.Text}" Visibility="Hidden" />
                        <ContentPresenter Margin="22,11,20,11" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Ebb.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Ebb.Surface}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ebb.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Segmented control (drive picker)  -->
    <Style x:Key="Ebb.Segment" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Ebb.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Ebb.Mono}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ebb.Focus}" />
        <Setter Property="Margin" Value="-1,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Root"
                        Padding="14,8"
                        Background="Transparent"
                        BorderBrush="{DynamicResource Ebb.BorderStrong}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Ebb.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Ebb.Inverse}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Ebb.Inverse}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ebb.InverseText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Long lists in the review window (virtualized)  -->
    <Style x:Key="Ebb.ItemList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer CanContentScroll="True" Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Padding="0,5" BorderBrush="{DynamicResource Ebb.Border}" BorderThickness="0,0,0,1">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Small outlined label: NEEDS ADMIN, CAN'T UNDO  -->
    <Style x:Key="Ebb.Tag" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Ebb.Text}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Ebb.TagText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ebb.Mono}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource Ebb.Text}" />
    </Style>

    <!--  Thin indeterminate progress line  -->
    <Style x:Key="Ebb.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="2" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid Background="{DynamicResource Ebb.Border}" ClipToBounds="True">
                        <Rectangle Width="160" HorizontalAlignment="Left" Fill="{DynamicResource Ebb.Text}">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="Move" X="-160" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Run">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Move" Storyboard.TargetProperty="X" From="-160" To="1600" Duration="0:0:1.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Run" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Tooltips: square, quiet  -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Ebb.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ebb.BorderStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource Ebb.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border MaxWidth="380" Padding="10,7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
