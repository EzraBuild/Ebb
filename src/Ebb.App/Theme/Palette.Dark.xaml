<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Monochrome, dark. Every color in the app comes from here or Palette.Light.xaml. -->
    <SolidColorBrush x:Key="Ebb.Bg" Color="#0A0A0A" />
    <SolidColorBrush x:Key="Ebb.Surface" Color="#121212" />
    <SolidColorBrush x:Key="Ebb.SurfaceHover" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Ebb.Border" Color="#262626" />
    <SolidColorBrush x:Key="Ebb.BorderStrong" Color="#404040" />
    <SolidColorBrush x:Key="Ebb.Text" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Ebb.TextMuted" Color="#A3A3A3" />
    <SolidColorBrush x:Key="Ebb.TextFaint" Color="#737373" />
    <SolidColorBrush x:Key="Ebb.Inverse" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Ebb.InverseHover" Color="#D4D4D4" />
    <SolidColorBrush x:Key="Ebb.InverseText" Color="#0A0A0A" />

    <!-- Diagonal stripes for "safe to remove" in the usage bar. -->
    <DrawingBrush x:Key="Ebb.Hatch" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,6 L6,0 M-1,1 L1,-1 M5,7 L7,5">
                <GeometryDrawing.Pen>
                    <Pen Brush="#FAFAFA" Thickness="1.2" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
