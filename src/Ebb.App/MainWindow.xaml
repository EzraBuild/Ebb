<ui:FluentWindow
    x:Class="Ebb.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Ebb.App.Views"
    xmlns:vm="clr-namespace:Ebb.App.ViewModels"
    Title="Ebb"
    Width="1180"
    Height="800"
    MinWidth="940"
    MinHeight="620"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Background="{DynamicResource Ebb.Bg}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{StaticResource Ebb.Sans}"
    FontSize="13"
    Foreground="{DynamicResource Ebb.Text}"
    WindowBackdropType="None"
    WindowCornerPreference="DoNotRound"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!--  A page of findings (Developer, Windows, Personal)  -->
        <DataTemplate DataType="{x:Type vm:FindingsPageViewModel}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,30,36,36">
                    <TextBlock Style="{StaticResource Ebb.Eyebrow}" Text="{Binding Eyebrow}" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Ebb.H2}" Text="{Binding Title}" />
                        <TextBlock
                            FontSize="21"
                            Style="{StaticResource Ebb.Number}"
                            Text="{Binding SizeText}" />
                    </Grid>
                    <TextBlock
                        MaxWidth="620"
                        Margin="0,8,0,22"
                        HorizontalAlignment="Left"
                        Style="{StaticResource Ebb.Body}"
                        Text="{Binding Description}" />
                    <Border
                        Padding="16,20"
                        BorderBrush="{DynamicResource Ebb.Border}"
                        BorderThickness="1"
                        Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource Ebb.Body}" Text="Nothing big here." />
                    </Border>
                    <ItemsControl Focusable="False" ItemsSource="{Binding Findings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FindingViewModel}">
                                <Border
                                    x:Name="Card"
                                    Margin="0,0,0,-1"
                                    Padding="18,16"
                                    Background="{DynamicResource Ebb.Bg}"
                                    BorderBrush="{DynamicResource Ebb.Border}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            Margin="0,2,0,0"
                                            AutomationProperties.Name="{Binding Title}"
                                            IsChecked="{Binding IsSelected}"
                                            Visibility="{Binding CanSelect, Converter={StaticResource Visible}}" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Ebb.Title}" Text="{Binding Title}" />
                                                <views:SafetyBadge Margin="12,0,0,0" Safety="{Binding Safety}" />
                                            </StackPanel>
                                            <TextBlock
                                                MaxWidth="720"
                                                Margin="0,7,0,0"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource Ebb.Body}"
                                                Text="{Binding Reason}" />
                                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                    MaxWidth="420"
                                                    Style="{StaticResource Ebb.Meta}"
                                                    Text="{Binding Meta}"
                                                    ToolTip="{Binding Finding.Path}" />
                                                <TextBlock
                                                    Margin="18,0,0,0"
                                                    Foreground="{DynamicResource Ebb.TextMuted}"
                                                    Style="{StaticResource Ebb.Meta}"
                                                    Text="{Binding ActionText}"
                                                    Visibility="{Binding HasActionText, Converter={StaticResource Visible}}" />
                                                <Button
                                                    Margin="18,0,0,0"
                                                    Command="{Binding OpenCommand}"
                                                    Content="{Binding OpenLabel}"
                                                    ContentStringFormat="{}{0} →"
                                                    Style="{StaticResource Ebb.Link}"
                                                    Visibility="{Binding CanOpen, Converter={StaticResource Visible}}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource Ebb.Number}"
                                            Text="{Binding SizeText}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource Ebb.Surface}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Ebb.Text}" />
                                        <Setter TargetName="Card" Property="Panel.ZIndex" Value="1" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!--  Biggest folders: a simple drill-down browser  -->
        <DataTemplate DataType="{x:Type vm:FoldersPageViewModel}">
            <DockPanel Margin="36,30,36,0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Ebb.Eyebrow}" Text="{Binding Eyebrow}" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Ebb.H2}" Text="{Binding Title}" />
                        <TextBlock
                            FontSize="21"
                            Style="{StaticResource Ebb.Number}"
                            Text="{Binding SizeText}" />
                    </Grid>
                    <TextBlock
                        MaxWidth="620"
                        Margin="0,8,0,20"
                        HorizontalAlignment="Left"
                        Style="{StaticResource Ebb.Body}"
                        Text="{Binding Description}" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Padding="12,6"
                            Command="{Binding UpCommand}"
                            Content="↑ Up"
                            Style="{StaticResource Ebb.Ghost}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="14,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Ebb.Text}"
                            Style="{StaticResource Ebb.Meta}"
                            Text="{Binding CurrentPath}" />
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Command="{Binding OpenInExplorerCommand}"
                            Content="Open in Explorer →"
                            Style="{StaticResource Ebb.Link}" />
                    </Grid>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        Margin="0,0,0,36"
                        BorderBrush="{DynamicResource Ebb.Border}"
                        BorderThickness="0,1,0,0"
                        Focusable="False"
                        ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FolderRowViewModel}">
                                <Button Command="{Binding OpenCommand}" Style="{StaticResource Ebb.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="14"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Ebb.Meta}"
                                                Text="{Binding Meta}" />
                                        </StackPanel>
                                        <Grid
                                            Grid.Column="1"
                                            Width="{x:Static vm:FolderRowViewModel.BarMax}"
                                            Height="4"
                                            Margin="16,0">
                                            <Rectangle Fill="{DynamicResource Ebb.Border}" />
                                            <Rectangle
                                                Width="{Binding BarWidth}"
                                                HorizontalAlignment="Left"
                                                Fill="{DynamicResource Ebb.Text}" />
                                        </Grid>
                                        <TextBlock
                                            Grid.Column="2"
                                            FontSize="13"
                                            Style="{StaticResource Ebb.Number}"
                                            Text="{Binding SizeText}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Ebb" Grid.Row="0" />

        <!--  Header: the question, the drive, the usage bar  -->
        <Border
            Grid.Row="1"
            Padding="36,6,36,22"
            BorderBrush="{DynamicResource Ebb.Border}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource Ebb.Eyebrow}" Text="DISK SPACE, EXPLAINED" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Style="{StaticResource Ebb.H1}"
                    Text="{Binding Heading}" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,6,0,0"
                    FontFamily="{StaticResource Ebb.Mono}"
                    Style="{StaticResource Ebb.Body}"
                    Text="{Binding DriveSummary}" />

                <StackPanel
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">
                    <ListBox
                        Margin="1,0,0,0"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding IsNotScanning}"
                        ItemContainerStyle="{StaticResource Ebb.Segment}"
                        ItemsSource="{Binding Drives}"
                        SelectedItem="{Binding SelectedDrive}"
                        Style="{StaticResource Ebb.PlainList}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriveViewModel}">
                                <TextBlock Text="{Binding Letter}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button
                        MinWidth="96"
                        Margin="12,0,0,0"
                        Command="{Binding ScanCommand}"
                        Content="Scan"
                        Style="{StaticResource Ebb.Primary}"
                        Visibility="{Binding IsNotScanning, Converter={StaticResource Visible}}" />
                    <Button
                        MinWidth="96"
                        Margin="12,0,0,0"
                        Command="{Binding ScanCancelCommand}"
                        Content="Stop"
                        Style="{StaticResource Ebb.Ghost}"
                        Visibility="{Binding IsScanning, Converter={StaticResource Visible}}" />
                </StackPanel>

                <!--  Used (solid) · safe to remove (striped) · free (empty)  -->
                <Grid
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Height="10"
                    Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding UsedLength}" />
                        <ColumnDefinition Width="{Binding SafeLength}" />
                        <ColumnDefinition Width="{Binding FreeLength}" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Fill="{DynamicResource Ebb.Text}" />
                    <Rectangle Grid.Column="1" Fill="{DynamicResource Ebb.Hatch}" />
                    <Rectangle Grid.Column="2" Fill="{DynamicResource Ebb.Border}" />
                </Grid>

                <Grid
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="10" Height="10" Fill="{DynamicResource Ebb.Text}" />
                        <TextBlock Margin="8,0,20,0" Style="{StaticResource Ebb.Meta}" Text="USED" />
                        <Rectangle Width="10" Height="10" Fill="{DynamicResource Ebb.Hatch}" Stroke="{DynamicResource Ebb.Text}" StrokeThickness="1" />
                        <TextBlock Margin="8,0,20,0" Style="{StaticResource Ebb.Meta}" Text="SAFE TO REMOVE" />
                        <Rectangle Width="10" Height="10" Fill="{DynamicResource Ebb.Border}" />
                        <TextBlock Margin="8,0,0,0" Style="{StaticResource Ebb.Meta}" Text="FREE" />
                    </StackPanel>
                    <TextBlock
                        HorizontalAlignment="Right"
                        Foreground="{DynamicResource Ebb.Text}"
                        Style="{StaticResource Ebb.Meta}"
                        Text="{Binding SafeSummary}" />
                </Grid>
            </Grid>
        </Border>

        <!--  Body: pages on the left, the selected page on the right  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{DynamicResource Ebb.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel Margin="22,18" DockPanel.Dock="Bottom">
                        <Button
                            HorizontalAlignment="Left"
                            Command="{Binding OpenLogCommand}"
                            Content="Cleanup log →"
                            Style="{StaticResource Ebb.Link}" />
                    </StackPanel>
                    <ListBox
                        Margin="0,18,0,0"
                        IsEnabled="{Binding HasResults}"
                        ItemContainerStyle="{StaticResource Ebb.NavItem}"
                        ItemsSource="{Binding Pages}"
                        SelectedItem="{Binding SelectedPage}"
                        Style="{StaticResource Ebb.PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PageViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="14" Text="{Binding Title}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Ebb.Mono}"
                                        FontSize="12"
                                        Text="{Binding SizeText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!--  Before the first scan  -->
            <StackPanel
                Grid.Column="1"
                MaxWidth="520"
                Margin="36,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                <TextBlock Style="{StaticResource Ebb.Eyebrow}" Text="READY" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource Ebb.H2}"
                    Text="Scan to see what's using space" />
                <TextBlock
                    Margin="0,8,0,20"
                    Style="{StaticResource Ebb.Body}"
                    Text="Scanning only reads your drive. Nothing is removed until you've seen exactly what will go and said OK." />
                <Button
                    HorizontalAlignment="Left"
                    Command="{Binding ScanCommand}"
                    Content="Scan now"
                    Style="{StaticResource Ebb.Primary}" />
            </StackPanel>

            <!--  While scanning  -->
            <StackPanel
                Grid.Column="1"
                MaxWidth="560"
                Margin="36,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Visibility="{Binding IsScanning, Converter={StaticResource Visible}}">
                <TextBlock Style="{StaticResource Ebb.Eyebrow}" Text="SCANNING" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontFamily="{StaticResource Ebb.Mono}"
                    FontSize="18"
                    Foreground="{DynamicResource Ebb.Text}"
                    Text="{Binding ProgressText}" />
                <ProgressBar Margin="0,18,0,0" Style="{StaticResource Ebb.Progress}" />
                <TextBlock
                    Margin="0,14,0,0"
                    Style="{StaticResource Ebb.Body}"
                    Text="A full drive takes a minute or two. Ebb only reads; it doesn't change anything." />
            </StackPanel>

            <!--  Results  -->
            <ContentControl
                Grid.Column="1"
                Content="{Binding SelectedPage}"
                Focusable="False"
                Visibility="{Binding HasResults, Converter={StaticResource Visible}}" />
        </Grid>

        <!--  Footer: selection and the one button that matters  -->
        <Border
            Grid.Row="3"
            Padding="36,14"
            BorderBrush="{DynamicResource Ebb.Border}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource Ebb.Text}" Text="{Binding SelectionText}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Ebb.Meta}"
                        Text="{Binding Notice}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        Command="{Binding SelectSafeCommand}"
                        Content="Tick everything safe"
                        Style="{StaticResource Ebb.Ghost}" />
                    <Button
                        Margin="10,0,0,0"
                        Command="{Binding ReviewCleanupCommand}"
                        Content="Review cleanup →"
                        Style="{StaticResource Ebb.Primary}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
