<ui:FluentWindow
    x:Class="Ebb.App.Views.CleanupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Ebb.App.ViewModels"
    Title="Review cleanup"
    Width="880"
    Height="740"
    MinWidth="720"
    MinHeight="520"
    d:DataContext="{d:DesignInstance Type=vm:CleanupViewModel}"
    Background="{DynamicResource Ebb.Bg}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{StaticResource Ebb.Sans}"
    FontSize="13"
    Foreground="{DynamicResource Ebb.Text}"
    ShowInTaskbar="False"
    WindowBackdropType="None"
    WindowCornerPreference="DoNotRound"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Review cleanup"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Border
            Grid.Row="1"
            Padding="36,6,36,22"
            BorderBrush="{DynamicResource Ebb.Border}"
            BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Style="{StaticResource Ebb.Eyebrow}" Text="{Binding Eyebrow}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource Ebb.H2}"
                    Text="{Binding Heading}" />
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource Ebb.Body}"
                    Text="{Binding Subheading}" />
                <CheckBox
                    Margin="0,18,0,0"
                    IsChecked="{Binding UseRecycleBin}"
                    Visibility="{Binding IsReview, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource Ebb.Text}" Text="Move removed files to the Recycle Bin (recommended)" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Ebb.Meta}"
                            Text="The space comes back once you empty the bin. Untick to delete them for good." />
                    </StackPanel>
                </CheckBox>
                <ProgressBar
                    Margin="0,18,0,0"
                    Style="{StaticResource Ebb.Progress}"
                    Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Border>

        <!--  The plan  -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding IsReview, Converter={StaticResource Visible}}">
            <StackPanel Margin="36,22,36,28">
                <ItemsControl Focusable="False" ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StepViewModel}">
                            <Border
                                Margin="0,0,0,-1"
                                Padding="18,16"
                                BorderBrush="{DynamicResource Ebb.Border}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Ebb.Title}" Text="{Binding Title}" />
                                            <Border Style="{StaticResource Ebb.Tag}" Visibility="{Binding NeedsAdmin, Converter={StaticResource Visible}}">
                                                <TextBlock Style="{StaticResource Ebb.TagText}" Text="ASKS FOR ADMIN" />
                                            </Border>
                                            <Border Style="{StaticResource Ebb.Tag}" Visibility="{Binding IsPermanent, Converter={StaticResource Visible}}">
                                                <TextBlock Style="{StaticResource Ebb.TagText}" Text="CAN'T UNDO" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Ebb.Number}" Text="{Binding SizeText}" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,7,0,0"
                                        Style="{StaticResource Ebb.Body}"
                                        Text="{Binding Description}" />
                                    <Border
                                        Margin="0,12,0,0"
                                        Padding="12,9"
                                        Background="{DynamicResource Ebb.Surface}"
                                        BorderBrush="{DynamicResource Ebb.Border}"
                                        BorderThickness="1"
                                        Visibility="{Binding HasCommand, Converter={StaticResource Visible}}">
                                        <TextBlock
                                            FontFamily="{StaticResource Ebb.Mono}"
                                            FontSize="12"
                                            Foreground="{DynamicResource Ebb.Text}"
                                            Text="{Binding CommandText}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <ItemsControl Margin="0,6,0,0" Focusable="False" ItemsSource="{Binding Warnings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    Foreground="{DynamicResource Ebb.Text}"
                                                    Text="{Binding StringFormat='! {0}'}"
                                                    TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
                                        <!--  Filter by folder: Tick all / Untick all then act on what's shown  -->
                                        <TextBox
                                            Margin="0,0,0,10"
                                            AutomationProperties.Name="Filter by folder"
                                            Style="{StaticResource Ebb.Input}"
                                            Tag="Filter by folder, e.g. Desktop/count"
                                            Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding CanFilter, Converter={StaticResource Visible}}" />
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Style="{StaticResource Ebb.Meta}" Text="{Binding ItemsSummary}" />
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <Button
                                                    Margin="0,0,16,0"
                                                    Command="{Binding ClearFilterCommand}"
                                                    Content="Clear filter"
                                                    Style="{StaticResource Ebb.Link}"
                                                    Visibility="{Binding IsFiltering, Converter={StaticResource Visible}}" />
                                                <Button Command="{Binding TickAllCommand}" Content="{Binding TickText}" Style="{StaticResource Ebb.Link}" />
                                                <Button
                                                    Margin="16,0,0,0"
                                                    Command="{Binding UntickAllCommand}"
                                                    Content="{Binding UntickText}"
                                                    Style="{StaticResource Ebb.Link}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock
                                            Margin="0,10,0,4"
                                            Style="{StaticResource Ebb.Body}"
                                            Text="Nothing here matches that."
                                            Visibility="{Binding NothingMatches, Converter={StaticResource Visible}}" />
                                        <ListBox
                                            MaxHeight="260"
                                            BorderBrush="{DynamicResource Ebb.Border}"
                                            ItemsSource="{Binding ShownItems}"
                                            Style="{StaticResource Ebb.ItemList}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:PlanItemViewModel}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="96" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox
                                                            AutomationProperties.Name="{Binding Path}"
                                                            IsChecked="{Binding Selected}"
                                                            IsEnabled="{Binding CanSelect}" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock
                                                                FontFamily="{StaticResource Ebb.Mono}"
                                                                FontSize="12"
                                                                Foreground="{DynamicResource Ebb.Text}"
                                                                Text="{Binding Path}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTip="{Binding Path}" />
                                                            <TextBlock Style="{StaticResource Ebb.Meta}" Text="{Binding Note}" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            FontSize="12"
                                                            Style="{StaticResource Ebb.Number}"
                                                            Text="{Binding SizeText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,28,0,0" Visibility="{Binding HasSkipped, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource Ebb.Eyebrow}" Text="NOT INCLUDED" />
                    <ItemsControl Margin="0,8,0,0" Focusable="False" ItemsSource="{Binding Skipped}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SkippedViewModel}">
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Ebb.Body}">
                                    <Run Foreground="{DynamicResource Ebb.Text}" Text="{Binding Title, Mode=OneWay}" />
                                    <Run Text="{Binding Reason, Mode=OneWay, StringFormat=' — {0}'}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Running: just the progress text in the header and footer  -->
        <TextBlock
            Grid.Row="2"
            Margin="36,24"
            FontFamily="{StaticResource Ebb.Mono}"
            FontSize="15"
            Foreground="{DynamicResource Ebb.Text}"
            Text="{Binding ProgressText}"
            Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" />

        <!--  Results  -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding IsDone, Converter={StaticResource Visible}}">
            <ItemsControl
                Margin="36,22,36,28"
                Focusable="False"
                ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ResultViewModel}">
                        <Border
                            Margin="0,0,0,-1"
                            Padding="18,14"
                            BorderBrush="{DynamicResource Ebb.Border}"
                            BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontFamily="{StaticResource Ebb.Mono}"
                                    FontSize="15"
                                    Foreground="{DynamicResource Ebb.Text}"
                                    Text="{Binding Symbol}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Ebb.Title}" Text="{Binding Title}" />
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        Style="{StaticResource Ebb.Body}"
                                        Text="{Binding Message}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource Ebb.Number}"
                                    Text="{Binding SizeText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border
            Grid.Row="3"
            Padding="36,14"
            BorderBrush="{DynamicResource Ebb.Border}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource Ebb.Body}"
                    Text="{Binding FooterText}" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding IsReview, Converter={StaticResource Visible}}">
                    <Button Command="{Binding CloseCommand}" Content="Cancel" Style="{StaticResource Ebb.Ghost}" IsCancel="True" />
                    <Button
                        Margin="10,0,0,0"
                        Command="{Binding CleanCommand}"
                        Content="{Binding ConfirmText}"
                        Style="{StaticResource Ebb.Primary}" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                    <Button Command="{Binding CleanCancelCommand}" Content="Stop after this step" Style="{StaticResource Ebb.Ghost}" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding IsDone, Converter={StaticResource Visible}}">
                    <Button Command="{Binding OpenLogCommand}" Content="Open log" Style="{StaticResource Ebb.Ghost}" />
                    <Button
                        Margin="10,0,0,0"
                        Command="{Binding CloseCommand}"
                        Content="Done"
                        Style="{StaticResource Ebb.Primary}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
