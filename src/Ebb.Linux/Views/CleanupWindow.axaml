<Window
    x:Class="Ebb.Linux.Views.CleanupWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System"
    xmlns:vm="using:Ebb.Linux.ViewModels"
    Title="Review cleanup"
    Width="880"
    Height="740"
    MinWidth="720"
    MinHeight="520"
    x:DataType="vm:CleanupViewModel"
    Background="{DynamicResource Ebb.Bg}"
    FontFamily="{DynamicResource Ebb.Sans}"
    FontFeatures="-liga, -calt"
    FontSize="13"
    Foreground="{DynamicResource Ebb.Text}"
    Icon="/Assets/ebb.png"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border
            Padding="36,26,36,22"
            BorderBrush="{DynamicResource Ebb.Border}"
            BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Classes="eyebrow" Text="{Binding Eyebrow}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Classes="h2"
                    Text="{Binding Heading}" />
                <TextBlock
                    Margin="0,6,0,0"
                    Classes="body"
                    Text="{Binding Subheading}" />
                <CheckBox
                    Margin="0,18,0,0"
                    IsChecked="{Binding UseTrash}"
                    IsVisible="{Binding IsReview}">
                    <StackPanel>
                        <TextBlock Text="Move removed files to the Trash (recommended)" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Classes="meta"
                            Text="The space comes back once you empty the Trash. Untick to delete them for good." />
                    </StackPanel>
                </CheckBox>
                <Border
                    Margin="0,18,0,0"
                    Classes="progress"
                    IsVisible="{Binding IsRunning}">
                    <Rectangle />
                </Border>
            </StackPanel>
        </Border>

        <!--  The plan  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            IsVisible="{Binding IsReview}"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,22,36,28">
                <ItemsControl ClipToBounds="False" Focusable="False" ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:StepViewModel">
                            <Border Padding="18,16" Classes="card">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Classes="title" Text="{Binding Title}" />
                                            <Border Classes="tag" IsVisible="{Binding NeedsAdmin}">
                                                <TextBlock Text="ASKS FOR PASSWORD" />
                                            </Border>
                                            <Border Classes="tag" IsVisible="{Binding IsPermanent}">
                                                <TextBlock Text="CAN'T UNDO" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Classes="number" Text="{Binding SizeText}" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,7,0,0"
                                        Classes="body"
                                        Text="{Binding Description}" />
                                    <Border
                                        Margin="0,12,0,0"
                                        Classes="command"
                                        IsVisible="{Binding HasCommand}">
                                        <TextBlock
                                            FontFamily="{DynamicResource Ebb.Mono}"
                                            FontSize="12"
                                            Text="{Binding CommandText}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <ItemsControl
                                        Margin="0,6,0,0"
                                        Focusable="False"
                                        ItemsSource="{Binding Warnings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="sys:String">
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    Text="{Binding StringFormat='! {0}'}"
                                                    TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Margin="0,12,0,0" IsVisible="{Binding HasItems}">
                                        <!--  Filter by folder: Tick all / Untick all then act on what's shown  -->
                                        <TextBox
                                            Margin="0,0,0,10"
                                            AutomationProperties.Name="Filter by folder"
                                            Classes="input"
                                            IsVisible="{Binding CanFilter}"
                                            Text="{Binding Filter}"
                                            Watermark="Filter by folder, e.g. code/shop" />
                                        <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="meta" Text="{Binding ItemsSummary}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button
                                                    Margin="0,0,16,0"
                                                    Command="{Binding ClearFilterCommand}"
                                                    Content="Clear filter"
                                                    IsVisible="{Binding IsFiltering}"
                                                    Theme="{StaticResource Ebb.Link}" />
                                                <Button
                                                    Command="{Binding TickAllCommand}"
                                                    Content="{Binding TickText}"
                                                    Theme="{StaticResource Ebb.Link}" />
                                                <Button
                                                    Margin="16,0,0,0"
                                                    Command="{Binding UntickAllCommand}"
                                                    Content="{Binding UntickText}"
                                                    Theme="{StaticResource Ebb.Link}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock
                                            Margin="0,10,0,4"
                                            Classes="body"
                                            IsVisible="{Binding NothingMatches}"
                                            Text="Nothing here matches that." />
                                        <ListBox
                                            MaxHeight="260"
                                            ItemsSource="{Binding ShownItems}"
                                            Theme="{StaticResource Ebb.ItemList}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="vm:PlanItemViewModel">
                                                    <Grid ColumnDefinitions="30,*,96">
                                                        <CheckBox
                                                            AutomationProperties.Name="{Binding Path}"
                                                            IsChecked="{Binding Selected}"
                                                            IsEnabled="{Binding CanSelect}" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock
                                                                FontFamily="{DynamicResource Ebb.Mono}"
                                                                FontSize="12"
                                                                Text="{Binding Path}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTip.Tip="{Binding Path}" />
                                                            <TextBlock Classes="meta" Text="{Binding Note}" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Classes="number"
                                                            FontSize="12"
                                                            Text="{Binding SizeText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,28,0,0" IsVisible="{Binding HasSkipped}">
                    <TextBlock Classes="eyebrow" Text="NOT INCLUDED" />
                    <ItemsControl
                        Margin="0,8,0,0"
                        Focusable="False"
                        ItemsSource="{Binding Skipped}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SkippedViewModel">
                                <TextBlock Margin="0,4,0,0" Classes="body">
                                    <Run Foreground="{DynamicResource Ebb.Text}" Text="{Binding Title, Mode=OneWay}" />
                                    <Run Text="{Binding Reason, Mode=OneWay, StringFormat=' — {0}'}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Running: just the progress text  -->
        <TextBlock
            Grid.Row="1"
            Margin="36,24"
            FontFamily="{DynamicResource Ebb.Mono}"
            FontSize="15"
            IsVisible="{Binding IsRunning}"
            Text="{Binding ProgressText}"
            TextWrapping="Wrap" />

        <!--  Results  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            IsVisible="{Binding IsDone}"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl
                Margin="36,22,36,28"
                ClipToBounds="False"
                Focusable="False"
                ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ResultViewModel">
                        <Border Padding="18,14" Classes="card">
                            <Grid ColumnDefinitions="30,*,110">
                                <TextBlock
                                    FontFamily="{DynamicResource Ebb.Mono}"
                                    FontSize="15"
                                    Text="{Binding Symbol}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="title" Text="{Binding Title}" />
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        Classes="body"
                                        Text="{Binding Message}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    Classes="number"
                                    Text="{Binding SizeText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="36,14"
            BorderBrush="{DynamicResource Ebb.Border}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    VerticalAlignment="Center"
                    Classes="body"
                    Text="{Binding FooterText}" />
                <StackPanel
                    Grid.Column="1"
                    IsVisible="{Binding IsReview}"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding CloseCommand}"
                        Content="Cancel"
                        IsCancel="True"
                        Theme="{StaticResource Ebb.Ghost}" />
                    <Button
                        Margin="10,0,0,0"
                        Command="{Binding CleanCommand}"
                        Content="{Binding ConfirmText}"
                        Theme="{StaticResource Ebb.Primary}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    IsVisible="{Binding IsRunning}"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding CleanCancelCommand}"
                        Content="Stop after this step"
                        Theme="{StaticResource Ebb.Ghost}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    IsVisible="{Binding IsDone}"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding OpenLogCommand}"
                        Content="Open log"
                        Theme="{StaticResource Ebb.Ghost}" />
                    <Button
                        Margin="10,0,0,0"
                        Command="{Binding CloseCommand}"
                        Content="Done"
                        Theme="{StaticResource Ebb.Primary}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
